@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brasil Burger - Connexion</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="brasil-dark full-page">
    <div class="login-page-container">
        <div class="login-card">
            <div class="logo-section">
                <img src="https://brasil-burger-buddy.lovable.app/assets/brasil-burger-logo-DNqGTY1E.png" 
                     alt="Brasil Burger" class="logo">
                <h1 class="brand-title">BRASIL BURGER</h1>
                <p class="tagline">🔥 L'authenticité brésilienne dans chaque bouchée 🔥</p>
            </div>
            
            <h2 class="page-title">Connexion</h2>
            <p class="page-subtitle">Accédez à votre espace personnel</p>
            
            <p class="profile-label">Choisissez votre profil</p>
            <div class="profile-selector">
                <div class="profile-card active" data-profile="client">
                    <i class="fas fa-user"></i>
                    <div class="profile-card-label">Client</div>
                </div>
                <div class="profile-card" data-profile="gestionnaire">
                    <i class="fas fa-briefcase"></i>
                    <div class="profile-card-label">Gestionnaire</div>
                </div>
                <div class="profile-card" data-profile="livreur">
                    <i class="fas fa-truck"></i>
                    <div class="profile-card-label">Livreur</div>
                </div>
            </div>
            
            <form asp-action="Login" method="post">
                <input type="hidden" id="profileType" name="profileType" value="client" />
                
                <div class="form-group">
                    <label class="form-label">Adresse email</label>
                    <input type="email" name="email" class="form-input" 
                           placeholder="votre@email.com" required />
                </div>
                
                <div class="form-group">
                    <label class="form-label">Mot de passe</label>
                    <input type="password" name="password" class="form-input" 
                           placeholder="••••••••" required />
                </div>
                
                <button type="submit" class="btn-submit">
                    Se connecter <i class="fas fa-arrow-right"></i>
                </button>
            </form>
            
            <div class="divider">ou</div>
            
            <p class="signup-text">
                Nouveau chez Brasil Burger ? 
                <a href="/Account/Register" class="signup-link">Créer un compte</a>
            </p>
        </div>
        
        <p class="login-footer">© 2025 Brasil Burger. Tous droits réservés.</p>
    </div>
    
    <script>
        document.querySelectorAll('.profile-card').forEach(card => {
            card.addEventListener('click', function() {
                document.querySelectorAll('.profile-card').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('profileType').value = this.dataset.profile;
            });
        });
    </script>
</body>
</html>
