{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Vue d'ensemble de l'activité du jour</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-content">
            <h3>{{ commandesEnCours }}</h3>
            <p>Commandes en cours</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-content">
            <h3>{{ commandesValidees }}</h3>
            <p>Commandes validées</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon danger">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-content">
            <h3>{{ commandesAnnulees }}</h3>
            <p>Commandes annulées</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-coins"></i>
        </div>
        <div class="stat-content">
            <h3>{{ recettesJournalieres }} FCFA</h3>
            <p>Recettes du jour</p>
        </div>
    </div>
</div>

<div class="card">
    <h2 style="color: #00ff88; font-size: 18px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-chart-line" style="font-size: 16px;"></i>
        BURGERS LES PLUS VENDUS
    </h2>
    
    {% if produitsPlusVendus is empty %}
        <p style="color: #888; text-align: center; padding: 30px;">Aucune vente aujourd'hui</p>
    {% else %}
        <div style="display: flex; flex-direction: column; gap: 20px;">
            {% for index, produit in produitsPlusVendus %}
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div style="font-size: 24px; font-weight: 700; color: #888; min-width: 40px;">#{{ index + 1 }}</div>
                    <div style="width: 60px; height: 60px; border-radius: 10px; overflow: hidden; background-color: #2a2a2a;">
                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 24px;">🍔</div>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 15px; font-weight: 600; color: #fff; margin-bottom: 3px;">{{ produit.burger ?? produit.menu }}</div>
                        <div style="font-size: 13px; color: #ff9500; font-weight: 600;">Prix unitaire</div>
                    </div>
                    <div style="text-align: right; color: #888; font-size: 13px;">
                        <span style="font-weight: 600;">{{ produit.total }}</span> ventes
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-top: 30px;">
    <a href="{{ path('app_dashboard') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-chart-line" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Dashboard</span>
    </a>
    <a href="{{ path('app_burger_index') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-burger" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Produits</span>
    </a>
    <a href="{{ path('app_commande_index') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-shopping-cart" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Commandes</span>
    </a>
    <a href="{{ path('app_zone_index') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-map-marked-alt" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Zones</span>
    </a>
    <a href="{{ path('app_livreur_index') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-users" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Livreurs</span>
    </a>
    <a href="{{ path('app_affectation_index') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-truck" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Affectations</span>
    </a>
    <a href="{{ path('app_statistiques') }}" style="padding: 15px; background-color: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 10px; text-decoration: none; color: #00ff88; display: flex; align-items: center; gap: 12px; transition: all 0.3s;">
        <i class="fas fa-chart-bar" style="font-size: 18px;"></i>
        <span style="font-size: 14px; font-weight: 500;">Statistiques</span>
    </a>
</div>

{% endblock %}
