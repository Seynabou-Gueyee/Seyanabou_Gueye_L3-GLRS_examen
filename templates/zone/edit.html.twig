{% extends 'base.html.twig' %}

{% block title %}Modifier une Zone{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="fas fa-edit"></i> Modifier une Zone</h1>
    <a href="{{ path('app_zone_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Retour
    </a>
</div>

<div class="card" style="max-width: 800px;">
    <div class="card-body">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="form-group">
                {{ form_label(form.prixLivraison) }}
                {{ form_widget(form.prixLivraison) }}
                {{ form_errors(form.prixLivraison) }}
            </div>
            <div class="form-group">
                {{ form_label(form.quartiers) }}
                {{ form_widget(form.quartiers) }}
                {{ form_errors(form.quartiers) }}
                <small style="color: #aaa; display: block; margin-top: 5px;">Séparez les quartiers par des virgules</small>
            </div>
            <div style="margin-top: 30px; display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Enregistrer
                </button>
                <a href="{{ path('app_zone_index') }}" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
