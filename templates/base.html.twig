<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BRASIL BURGER{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0a0a0a;
            color: #fff;
        }

        .container-fluid {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background-color: #1a1a1a;
            border-right: 1px solid #2a2a2a;
            padding: 20px 0;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
        }

        .sidebar-header {
            padding: 0 20px 30px;
            border-bottom: 1px solid #2a2a2a;
            margin-bottom: 20px;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-decoration: none;
        }

        .sidebar-logo img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .sidebar-logo-text h3 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .sidebar-logo-text p {
            font-size: 12px;
            color: #888;
        }

        .sidebar-nav {
            list-style: none;
        }

        .sidebar-nav li {
            margin-bottom: 5px;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            color: #00ff88;
            text-decoration: none;
            transition: all 0.3s;
            font-size: 14px;
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active {
            background-color: #2a2a2a;
            border-left: 3px solid #00ff88;
        }

        .sidebar-nav i {
            width: 20px;
            font-size: 16px;
        }

        .sidebar-footer {
            position: absolute;
            bottom: 20px;
            left: 0;
            right: 0;
            padding: 0 20px;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            background-color: transparent;
            border: 1px solid #ff4444;
            color: #ff4444;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            width: 100%;
            text-decoration: none;
            font-size: 14px;
        }

        .btn-logout:hover {
            background-color: #ff4444;
            color: #fff;
        }

        /* Main Content */
        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 30px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #2a2a2a;
        }

        .top-bar-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .top-bar-logo {
            width: 35px;
            height: 35px;
        }

        .top-bar h2 {
            font-size: 16px;
            color: #00ff88;
            font-weight: 500;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 15px;
            background-color: #1a1a1a;
            border-radius: 20px;
            cursor: pointer;
        }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: #00ff88;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
            font-weight: 600;
            font-size: 14px;
        }

        /* Page Title */
        .page-header {
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 28px;
            color: #00ff88;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .page-subtitle {
            color: #888;
            font-size: 14px;
        }

        /* Buttons */
        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background-color: #ff9500;
            color: #000;
            border: 2px solid #ff9500;
        }

        .btn-primary:hover {
            background-color: transparent;
            color: #ff9500;
        }

        .btn-success {
            background-color: #00ff88;
            color: #000;
        }

        .btn-success:hover {
            background-color: #00dd77;
        }

        .btn-danger {
            background-color: #ff4444;
            color: #fff;
        }

        .btn-danger:hover {
            background-color: #dd3333;
        }

        .btn-secondary {
            background-color: transparent;
            color: #ff9500;
            border: 2px solid #ff9500;
        }

        .btn-secondary:hover {
            background-color: #ff9500;
            color: #000;
        }

        .btn-sm {
            padding: 6px 15px;
            font-size: 12px;
        }

        .btn-add {
            background-color: #00ff88;
            color: #000;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            float: right;
            margin-bottom: 20px;
        }

        .btn-add:hover {
            background-color: #00dd77;
        }

        /* Cards */
        .card {
            background-color: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background-color: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 25px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .stat-icon.warning {
            background-color: rgba(255, 149, 0, 0.1);
            color: #ff9500;
        }

        .stat-icon.success {
            background-color: rgba(0, 255, 136, 0.1);
            color: #00ff88;
        }

        .stat-icon.danger {
            background-color: rgba(255, 68, 68, 0.1);
            color: #ff4444;
        }

        .stat-icon.info {
            background-color: rgba(0, 136, 255, 0.1);
            color: #0088ff;
        }

        .stat-content h3 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-content p {
            color: #888;
            font-size: 13px;
        }

        /* Table */
        .table-container {
            background-color: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background-color: #0f0f0f;
        }

        th {
            padding: 15px;
            text-align: left;
            color: #00ff88;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
        }

        td {
            padding: 15px;
            border-top: 1px solid #2a2a2a;
            font-size: 14px;
        }

        tr:hover {
            background-color: #222;
        }

        /* Badge */
        .badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            display: inline-block;
        }

        .badge-warning {
            background-color: rgba(255, 149, 0, 0.2);
            color: #ff9500;
        }

        .badge-success {
            background-color: rgba(0, 255, 136, 0.2);
            color: #00ff88;
        }

        .badge-danger {
            background-color: rgba(255, 68, 68, 0.2);
            color: #ff4444;
        }

        .badge-info {
            background-color: rgba(0, 136, 255, 0.2);
            color: #0088ff;
        }

        /* Flash Messages */
        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid;
        }

        .alert-success {
            background-color: rgba(0, 255, 136, 0.1);
            border-color: #00ff88;
            color: #00ff88;
        }

        .alert-danger {
            background-color: rgba(255, 68, 68, 0.1);
            border-color: #ff4444;
            color: #ff4444;
        }

        /* Form */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #888;
            font-size: 13px;
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            background-color: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
        }

        .form-control:focus {
            outline: none;
            border-color: #00ff88;
        }

        select.form-control {
            cursor: pointer;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        {% block extra_styles %}{% endblock %}
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="{{ path('app_dashboard') }}" class="sidebar-logo">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23ff9500'/%3E%3Ctext x='50' y='65' text-anchor='middle' font-size='50' fill='%23000' font-weight='bold'%3EB%3C/text%3E%3C/svg%3E" alt="Logo">
                    <div class="sidebar-logo-text">
                        <h3>BRASIL BURGER</h3>
                        <p>Gestion</p>
                    </div>
                </a>
            </div>
            
            <ul class="sidebar-nav">
                <li>
                    <a href="{{ path('app_dashboard') }}" class="{{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_burger_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_burger' or app.request.attributes.get('_route') starts with 'app_menu' or app.request.attributes.get('_route') starts with 'app_complement' ? 'active' : '' }}">
                        <i class="fas fa-burger"></i>
                        <span>Produits</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_commande_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_commande' ? 'active' : '' }}">
                        <i class="fas fa-shopping-cart"></i>
                        <span>Commandes</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_zone_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_zone' ? 'active' : '' }}">
                        <i class="fas fa-map-marked-alt"></i>
                        <span>Zones</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_livreur_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_livreur' ? 'active' : '' }}">
                        <i class="fas fa-users"></i>
                        <span>Livreurs</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_affectation_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_affectation' ? 'active' : '' }}">
                        <i class="fas fa-truck"></i>
                        <span>Affectations</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_statistiques') }}">
                        <i class="fas fa-chart-bar"></i>
                        <span>Statistiques</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="{{ path('app_logout') }}" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Déconnexion</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="top-bar">
                <div class="top-bar-left">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23ff9500'/%3E%3Ctext x='50' y='65' text-anchor='middle' font-size='50' fill='%23000' font-weight='bold'%3EB%3C/text%3E%3C/svg%3E" alt="Logo" class="top-bar-logo">
                    <h2>GESTION - BRASIL BURGER</h2>
                </div>
                <div class="user-profile">
                    <div class="user-avatar">G</div>
                    <span>Gestion</span>
                </div>
            </div>

            <!-- Flash Messages -->
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>
