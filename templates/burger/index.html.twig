{% extends 'base.html.twig' %}

{% block title %}Gestion des Burgers{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="fas fa-burger"></i> Gestion des Burgers</h1>
    <a href="{{ path('app_burger_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Ajouter un Burger
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>État</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% if burgers is empty %}
                <tr>
                    <td colspan="5" style="text-align: center; padding: 40px; color: #666;">
                        <i class="fas fa-inbox" style="font-size: 48px; margin-bottom: 10px; display: block;"></i>
                        Aucun burger disponible
                    </td>
                </tr>
                {% else %}
                    {% for burger in burgers %}
                    <tr>
                        <td>
                            {% if burger.image %}
                                <img src="{{ asset('uploads/' ~ burger.image) }}" width="60" height="60" style="border-radius: 8px; object-fit: cover;">
                            {% else %}
                                <div style="width: 60px; height: 60px; background: #2a2a2a; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-burger" style="color: #666;"></i>
                                </div>
                            {% endif %}
                        </td>
                        <td><strong>{{ burger.nom }}</strong></td>
                        <td><span style="color: #ff9500; font-weight: 600;">{{ burger.prix }} FCFA</span></td>
                        <td>
                            {% if burger.archive %}
                                <span class="badge badge-danger">Archivé</span>
                            {% else %}
                                <span class="badge badge-success">Actif</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_burger_edit', {id: burger.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="{{ path('app_burger_archive', {id: burger.id}) }}" class="btn btn-sm btn-secondary" title="{{ burger.archive ? 'Désarchiver' : 'Archiver' }}">
                                <i class="fas fa-{{ burger.archive ? 'undo' : 'archive' }}"></i>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
