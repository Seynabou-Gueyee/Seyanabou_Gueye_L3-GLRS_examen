{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title"><i class="fas fa-chart-bar"></i> Statistiques</h1>
    <p class="page-subtitle">Analyse des performances et des ventes</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-coins"></i>
        </div>
        <div class="stat-content">
            <h3>{{ recettesJournalieres }} FCFA</h3>
            <p>Recettes du jour</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-content">
            <h3>{{ commandesEnCours }}</h3>
            <p>Commandes en cours</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-content">
            <h3>{{ commandesValidees }}</h3>
            <p>Commandes validées</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon danger">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-content">
            <h3>{{ commandesAnnulees }}</h3>
            <p>Commandes annulées</p>
        </div>
    </div>
</div>

<div class="card" style="margin-top: 30px;">
    <h2 style="color: #00ff88; font-size: 20px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-chart-line"></i>
        PRODUITS LES PLUS VENDUS DU JOUR
    </h2>
    
    {% if produitsPlusVendus is empty %}
        <div style="text-align: center; padding: 60px; color: #666;">
            <i class="fas fa-chart-pie" style="font-size: 64px; margin-bottom: 20px; display: block; opacity: 0.3;"></i>
            <p style="font-size: 16px; margin-bottom: 10px;">Aucune vente enregistrée aujourd'hui</p>
            <p style="font-size: 14px; opacity: 0.7;">Les statistiques apparaîtront dès que des commandes seront passées</p>
        </div>
    {% else %}
        <div style="display: flex; flex-direction: column; gap: 20px;">
            {% for index, produit in produitsPlusVendus %}
                <div style="display: flex; align-items: center; gap: 20px; padding: 15px; background: #0f0f0f; border-radius: 12px; transition: all 0.3s;">
                    <div style="font-size: 32px; font-weight: 800; background: linear-gradient(135deg, #ff9500, #00ff88); -webkit-background-clip: text; -webkit-text-fill-color: transparent; min-width: 50px; text-align: center;">
                        #{{ index + 1 }}
                    </div>
                    <div style="width: 70px; height: 70px; border-radius: 12px; overflow: hidden; background: linear-gradient(135deg, rgba(255, 149, 0, 0.1), rgba(0, 255, 136, 0.1)); border: 2px solid #2a2a2a;">
                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 32px;">
                            {{ produit.menu ? '📦' : '🍔' }}
                        </div>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 17px; font-weight: 600; color: #fff; margin-bottom: 5px;">
                            {{ produit.burger ?? produit.menu }}
                        </div>
                        <div style="font-size: 13px; color: #888;">
                            <span style="color: #ff9500; font-weight: 600;">{{ produit.total }}</span> vente{{ produit.total > 1 ? 's' : '' }}
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 24px; font-weight: 700; color: #00ff88;">
                            {{ produit.total }}
                        </div>
                        <div style="font-size: 12px; color: #666;">unités</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<div class="card" style="margin-top: 30px;">
    <h2 style="color: #00ff88; font-size: 20px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px;">
        <i class="fas fa-info-circle"></i>
        RÉSUMÉ DES COMMANDES
    </h2>
    
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        <div style="text-align: center; padding: 25px; background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 12px;">
            <i class="fas fa-clock" style="font-size: 32px; color: #ffc107; margin-bottom: 15px;"></i>
            <div style="font-size: 28px; font-weight: 700; color: #ffc107; margin-bottom: 5px;">{{ commandesEnCours }}</div>
            <div style="font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 1px;">En cours</div>
        </div>
        
        <div style="text-align: center; padding: 25px; background: rgba(0, 255, 136, 0.1); border: 1px solid rgba(0, 255, 136, 0.3); border-radius: 12px;">
            <i class="fas fa-check-circle" style="font-size: 32px; color: #00ff88; margin-bottom: 15px;"></i>
            <div style="font-size: 28px; font-weight: 700; color: #00ff88; margin-bottom: 5px;">{{ commandesValidees }}</div>
            <div style="font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 1px;">Validées</div>
        </div>
        
        <div style="text-align: center; padding: 25px; background: rgba(255, 68, 68, 0.1); border: 1px solid rgba(255, 68, 68, 0.3); border-radius: 12px;">
            <i class="fas fa-times-circle" style="font-size: 32px; color: #ff4444; margin-bottom: 15px;"></i>
            <div style="font-size: 28px; font-weight: 700; color: #ff4444; margin-bottom: 5px;">{{ commandesAnnulees }}</div>
            <div style="font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 1px;">Annulées</div>
        </div>
    </div>
</div>

{% endblock %}
